{
  "buildCommand": "node build-data.js",
  "outputDirectory": ".",
  "framework": null,
  "rewrites": [{ "source": "/darkroom", "destination": "/darkroom/index.html" }],
  "redirects": [
    { "source": "/contact", "destination": "/#contact", "permanent": true },
    { "source": "/portfolio", "destination": "/#portfolio", "permanent": true },
    { "source": "/albums", "destination": "/", "permanent": true },
    { "source": "/gear", "destination": "/darkroom", "permanent": true }
  ]
}
